{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "richman",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-21",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "richman-db",
      "database_id": "4e1edba6-f1b4-4057-b620-2457945b9a9d",
      "migrations_dir": "migrations"
    }
  ]
}